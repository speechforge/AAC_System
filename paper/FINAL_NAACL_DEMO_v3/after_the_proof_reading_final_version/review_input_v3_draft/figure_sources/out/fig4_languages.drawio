<mxfile host="app.diagrams.net"><diagram id="fig4_languages" name="fig4_languages"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_base" value="Baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#6B6B6B;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontColor=#6B6B6B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="74" y="1.8" width="142" height="217.8" as="geometry"/></mxCell><mxCell id="g_prop" value="Proposed Indic extension" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6FAFD;strokeColor=#155B8A;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontColor=#155B8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="1.8" width="424" height="217.8" as="geometry"/></mxCell><mxCell id="lab0" value="&lt;b&gt;1  Selection&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FA;strokeColor=#0072B2;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="4" y="21.6" width="66" height="30.6" as="geometry"/></mxCell><mxCell id="lab1" value="&lt;b&gt;2  Cascade&lt;/b&gt;&lt;br&gt;output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F4EC;strokeColor=#007A5A;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="4" y="61.2" width="66" height="50.4" as="geometry"/></mxCell><mxCell id="lab2" value="&lt;b&gt;3  Gate&lt;/b&gt;&lt;br&gt;check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#B03A2E;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="4" y="120.60000000000001" width="66" height="34.2" as="geometry"/></mxCell><mxCell id="lab3" value="&lt;b&gt;4  Spoken&lt;/b&gt;&lt;br&gt;sentence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="4" y="163.8" width="66" height="50.4" as="geometry"/></mxCell><mxCell id="h0" value="English&lt;br&gt;No + Water" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78" y="21.6" width="134" height="30.6" as="geometry"/></mxCell><mxCell id="c0" value="“I am not and will&lt;br&gt;eat at.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#AC252B;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="78" y="61.2" width="134" height="50.4" as="geometry"/></mxCell><mxCell id="g0" value="Rejected twice&lt;br&gt;selected concept missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#AC252B;strokeWidth=1.5;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="78" y="120.60000000000001" width="134" height="34.2" as="geometry"/></mxCell><mxCell id="p0" value="“I want No Water.”&lt;br&gt;template floor&lt;br&gt;template; stilted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#155B8A;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="78" y="163.8" width="134" height="50.4" as="geometry"/></mxCell><mxCell id="h1" value="Hindi&lt;br&gt;नहीं + पानी" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FA;strokeColor=#0072B2;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="219" y="21.6" width="134" height="30.6" as="geometry"/></mxCell><mxCell id="c1" value="“नहीं, मैं नहीं चाहिए।”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#AC252B;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="219" y="61.2" width="134" height="50.4" as="geometry"/></mxCell><mxCell id="g1" value="Rejected twice&lt;br&gt;selected concept missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#AC252B;strokeWidth=1.5;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="219" y="120.60000000000001" width="134" height="34.2" as="geometry"/></mxCell><mxCell id="p1" value="“मुझे नहीं पानी चाहिए।”&lt;br&gt;template floor&lt;br&gt;gloss: “I do not want water”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F1F8;strokeColor=#155B8A;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="219" y="163.8" width="134" height="50.4" as="geometry"/></mxCell><mxCell id="h2" value="Gujarati&lt;br&gt;ના + પાણી" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FA;strokeColor=#0072B2;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="21.6" width="134" height="30.6" as="geometry"/></mxCell><mxCell id="c2" value="“મને પાણી ના જોઈએ છે.”&lt;br&gt;gloss: “I do not want water”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F0;strokeColor=#17674A;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="61.2" width="134" height="50.4" as="geometry"/></mxCell><mxCell id="g2" value="Accepted&lt;br&gt;all checks pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F0;strokeColor=#17674A;strokeWidth=1.5;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="360" y="120.60000000000001" width="134" height="34.2" as="geometry"/></mxCell><mxCell id="p2" value="“મને પાણી ના જોઈએ છે.”&lt;br&gt;model sentence&lt;br&gt;gloss: “I do not want water”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F0;strokeColor=#17674A;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="163.8" width="134" height="50.4" as="geometry"/></mxCell><mxCell id="h3" value="Marathi&lt;br&gt;नाही + पाणी" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FA;strokeColor=#0072B2;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="501" y="21.6" width="134" height="30.6" as="geometry"/></mxCell><mxCell id="c3" value="“मला पाणी हवे आहे.”&lt;br&gt;gloss: “I want water”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#AC252B;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1"><mx